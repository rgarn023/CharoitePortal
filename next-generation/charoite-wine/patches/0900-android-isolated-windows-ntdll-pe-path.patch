diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -2075,9 +2075,29 @@
     InitializeObjectAttributes( &attr, &str, 0, 0, NULL );
 
-    if (build_dir) asprintf( &name, "%s%s/ntdll.dll", ntdll_dir, pe_dir );
-    else asprintf( &name, "%s%s/ntdll.dll", dll_dir, pe_dir );
-
-    if (is_arm64ec()) machine = main_image_info.Machine;
-    status = open_builtin_pe_file( name, &attr, &module, &size, &info, 0, 0, machine, FALSE, 0 );
-    if (status == STATUS_DLL_NOT_FOUND)
-    {
+#if defined(__ANDROID__) && defined(__aarch64__)
+    /* Charoite Wine28: APK-native Unix ntdll.so does not have a sibling
+     * Windows ntdll.dll. The caller verifies a fresh isolated PE directory. */
+    if (getenv( "CHAROITE_WINE28_PE_DIR" ))
+    {
+        const char *dir = getenv( "CHAROITE_WINE28_PE_DIR" );
+        char *resolved;
+        if (dir[0] != '/' || strstr( dir, ".." ) || strchr( dir, ':' ) ||
+            !(resolved = realpath( dir, NULL )))
+            fatal_error( "invalid isolated Wine28 Windows NTDLL directory\n" );
+        if (asprintf( &name, "%s/ntdll.dll", resolved ) < 0)
+            fatal_error( "cannot construct isolated Wine28 NTDLL path\n" );
+        free( resolved );
+    }
+    else
+#endif
+    if (build_dir) asprintf( &name, "%s%s/ntdll.dll", ntdll_dir, pe_dir );
+    else asprintf( &name, "%s%s/ntdll.dll", dll_dir, pe_dir );
+
+    if (is_arm64ec()) machine = main_image_info.Machine;
+    status = open_builtin_pe_file( name, &attr, &module, &size, &info, 0, 0, machine, FALSE, 0 );
+#if defined(__ANDROID__) && defined(__aarch64__)
+    if (getenv( "CHAROITE_WINE28_PE_DIR" ) && status == STATUS_DLL_NOT_FOUND)
+        fatal_error( "verified isolated Wine28 Windows NTDLL PE was not found\n" );
+#endif
+    if (status == STATUS_DLL_NOT_FOUND)
+    {
