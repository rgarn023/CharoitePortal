diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -528,6 +528,22 @@ static void init_paths( char *argv[] )
         }
 #endif
         if (!bin_dir) bin_dir = build_relative_path( dll_dir, LIBDIR "/wine", BINDIR );
+#if defined(__ANDROID__) && defined(__aarch64__)
+        /* Charoite Next: APK-installed native ELFs are read-only and have
+         * no sibling share/wine directory. Permit an isolated, explicit
+         * runtime data directory containing source-verified NLS files.
+         * Unset by default; normal Wine installation lookup is unchanged.
+         * The Android caller restricts this to its new one-shot sandbox. */
+        if (getenv( "CHAROITE_WINE26_DATA_DIR" ))
+        {
+            const char *dir = getenv( "CHAROITE_WINE26_DATA_DIR" );
+            if (dir[0] != '/' || strstr( dir, "/../" ) || strstr( dir, "/./" ))
+                fatal_error( "invalid isolated Wine data directory\n" );
+            if (!(data_dir = realpath( dir, NULL )))
+                fatal_error( "isolated Wine data directory not accessible\n" );
+        }
+        else
+#endif
         data_dir = build_relative_path( bin_dir, BINDIR, DATADIR "/wine" );
         wineloader = build_path( bin_dir, basename );
     }

diff --git a/loader/main.c b/loader/main.c
--- a/loader/main.c
+++ b/loader/main.c
@@ -244,3 +244,13 @@ static void *load_ntdll( char *argv0 )
 #endif
 
+#if defined(__ANDROID__) && defined(__aarch64__)
+    /* Charoite Next new source cohort: require a distinct verified ntdll.
+     * If explicitly requested and missing, never fall back to Wine22. */
+    if (!handle && (path = getenv( "CHAROITE_WINE27_NATIVE_DIR" )))
+    {
+        if (path[0] != '/' || strstr( path, ".." ) || strchr( path, ':' )) return NULL;
+        if (!(handle = try_dlopen( path, "libcharoite_wine27_ntdll.so" ))) return NULL;
+    }
+#endif
+
     if (!handle && (path = getenv( "WINEDLLPATH" )))

diff --git a/server/unicode.c b/server/unicode.c
--- a/server/unicode.c
+++ b/server/unicode.c
@@ -275,2 +275,16 @@ static char *get_nls_dir(void)
 static char *get_nls_dir(void)
 {
+#if defined(__ANDROID__) && defined(__aarch64__)
+    /* Use the exact same caller-verified NLS cohort as the native ntdll. */
+    const char *isolated = getenv( "CHAROITE_WINE26_DATA_DIR" );
+    if (isolated)
+    {
+        char *name, *resolved;
+        if (isolated[0] != '/' || strstr( isolated, "/../" ) || strstr( isolated, "/./" )) return NULL;
+        if (asprintf( &name, "%s/nls", isolated ) == -1) return NULL;
+        resolved = realpath( name, NULL );
+        free( name );
+        return resolved;
+    }
+#endif
+
