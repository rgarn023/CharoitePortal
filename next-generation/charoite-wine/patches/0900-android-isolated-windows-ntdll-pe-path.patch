     status = open_builtin_pe_file( name, &attr, &module, &size, &info, 0, 0, machine, FALSE, 0 );
+#if defined(__ANDROID__) && defined(__aarch64__)
+    if (getenv( "CHAROITE_WINE28_PE_DIR" ) && status == STATUS_DLL_NOT_FOUND)
+        fatal_error( "verified isolated Wine28 Windows NTDLL PE was not found\n" );
+#endif
     if (status == STATUS_DLL_NOT_FOUND)
