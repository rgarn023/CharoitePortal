diff --git a/tools/winegcc/winegcc.c b/tools/winegcc/winegcc.c
--- a/tools/winegcc/winegcc.c
+++ b/tools/winegcc/winegcc.c
@@ -1253,10 +1253,19 @@
         switch (opts->target.platform)
         {
         case PLATFORM_MINGW:
         case PLATFORM_CYGWIN:
-            libgcc = find_libgcc( opts->prefix, link_args );
-            if (!libgcc) libgcc = "-lgcc";
+            /* LLVM ARM64 and ARM64EC PE builds with --no-default-config
+             * use Wine's PE imports / LLVM toolchain, not GCC. Clang's
+             * '-print-libgcc-file-name' can report bare nonexistent
+             * 'libgcc.a', breaking both DLL and wineboot.exe link stages.
+             * Preserve GCC handling on all other build configurations. */
+            if (!((opts->target.cpu == CPU_ARM64 || opts->target.cpu == CPU_ARM64EC) &&
+                  opts->no_default_config))
+            {
+                libgcc = find_libgcc( opts->prefix, link_args );
+                if (!libgcc) libgcc = "-lgcc";
+            }
             break;
         default:
             break;
         }
