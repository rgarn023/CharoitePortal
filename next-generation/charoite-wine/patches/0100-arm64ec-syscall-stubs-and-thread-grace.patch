diff --git a/dlls/ntdll/thread.c b/dlls/ntdll/thread.c
index d3f25fa7417..ee9d2bac47e 100644
--- a/dlls/ntdll/thread.c
+++ b/dlls/ntdll/thread.c
@@ -263,9 +263,16 @@ void set_native_thread_name( DWORD tid, const char *name )
 void WINAPI RtlExitUserThread( ULONG status )
 {
     ULONG last;
+#ifdef __aarch64__
+    LARGE_INTEGER grace = { .QuadPart = -1000000 }; /* 100 ms, diagnostic only */
+#endif
 
     NtQueryInformationThread( GetCurrentThread(), ThreadAmILastThread, &last, sizeof(last), NULL );
     if (last) RtlExitUserProcess( status );
+#ifdef __aarch64__
+    /* Test whether a short-lived worker exits before its creator suspends it. */
+    NtDelayExecution( FALSE, &grace );
+#endif
     LdrShutdownThread();
     for (;;) NtTerminateThread( GetCurrentThread(), status );
 }
diff --git a/dlls/ntdll/unix/signal_arm64.c b/dlls/ntdll/unix/signal_arm64.c
--- a/dlls/ntdll/unix/signal_arm64.c
+++ b/dlls/ntdll/unix/signal_arm64.c
@@ -204,12 +204,14 @@ struct arm64_thread_data
 {
     struct syscall_frame *syscall_frame; /* 02f0 frame pointer on syscall entry */
     SYSTEM_SERVICE_TABLE *syscall_table; /* 02f8 syscall table */
     BOOL suspend_pending;
+    void *syscall_dispatcher;            /* 0308 survives copied Nt* stubs */
 };
 
 C_ASSERT( sizeof(struct arm64_thread_data) <= sizeof(((struct ntdll_thread_data *)0)->cpu_data) );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct arm64_thread_data, syscall_frame ) == 0x2f0 );
 C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct arm64_thread_data, syscall_table ) == 0x2f8 );
+C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct arm64_thread_data, syscall_dispatcher ) == 0x308 );
 
 static inline struct arm64_thread_data *arm64_thread_data(void)
 {
@@ -1521,7 +1523,8 @@ void call_init_thunk( LPTHREAD_START_ROUTINE entry, void *arg, BOOL suspend, TEB
     ARM_CONTEXT *arm_context;
 
     thread_data->syscall_table = KeServiceDescriptorTable;
     thread_data->suspend_pending = FALSE;
+    thread_data->syscall_dispatcher = __wine_syscall_dispatcher;
 
     context.X0  = (DWORD64)entry;
     context.X1  = (DWORD64)arg;
